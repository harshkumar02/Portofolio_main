rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isValidSize(size) {
      return size < 10 * 1024 * 1024; // 10MB max
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Certificates folder - public read
    match /certificates/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && isValidSize(request.resource.size)
                   && isImageOrPdf();
    }

    // Profile images - public read
    match /profile-images/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}